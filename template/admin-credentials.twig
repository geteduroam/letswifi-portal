{% extends 'admin.twig' %}

{% block title %}{{ 'Control panel'|translate_raw }}{% endblock %}

{% block admin_content %}
	<h1>{{ 'Pseudo credentials'|t }}</h1>
	<section class="highlight">
	<form>
		{% set filter_open = __filter_requester or __filter_ident or __filter_mask_revoked or __filter_mask_unrevoked or __filter_realms or __filter_show_times ? 'open ' : '' %}
		<details {{ filter_open }} class="form">
		<summary>{{ 'admin_filter_heading'|t }}</summary>
			<div class="cols">
				<div>
					<dl>
						<dt>{{ 'admin_filter_valid_on'|t }}</dt>
						<dd><input type="datetime-local" name="valid_on" value="{{ __filter_valid_on|split('+')|first }}"> UTC</dd>
					</dl>
					<dl>
						<dt>{{ 'admin_filter_ident'|t }}</dt>
						<dd>
							<input type="text" name="ident" value="{{ __filter_ident }}">
						</dd>
					</dl>
					<dl>
						<dt>{{ 'admin_filter_requester'|t }}</dt>
						<dd>
							<input type="text" name="requester" value="{{ __filter_requester }}">
						</dd>
					</dl>
					<dl>
						<dt>{{ 'admin_filter_mask'|t }}</dt>
						<dd>
							<input type="checkbox" id="filter-mask-revoked" name="revoked" value="off" {{ __filter_mask_revoked ? ' checked' : '' }}>
							<label for="filter-mask-revoked">{{ 'admin_filter_mask_revoked'|t }}</label>
							<input type="checkbox" id="filter-mask-unrevoked" name="unrevoked" value="off" {{ __filter_mask_unrevoked ? ' checked' : '' }}>
							<label for="filter-mask-unrevoked">{{ 'admin_filter_mask_unrevoked'|t }}</label>
					{% if 'admin_filter_mask'|t != 'admin_filter_show'|t %}
					{# If the translation for "mask" and "show" is the same, remove the distinction #}
						</dd>
					</dl>
					<dl>
						<dt>{{ 'admin_filter_show'|t }}</dt>
						<dd>
					{% endif %}
							<input type="checkbox" id="filter-show-times" name="times" value="on" {{ __filter_show_times ? ' checked' : '' }}>
							<label for="filter-show-times">{{ 'admin_filter_show_times'|t }}</label>
						</dd>
					</dl>

				</div>
				{% set realms = _realms %}
				{{ include('_realms-picker.twig') }}
			</div>
			<p><button type="submit">
				<small class="oojs-icon oojs-icon-funnel"></small>
				{{ 'admin_filter_submit'|t }}
			</button>
		</details>
	</form>
	</section>

	<hr>

	{% if credentials %}
	<form method="POST">
		<input type="hidden" name="http_form_post_redirect" value="1">
		<input type="hidden" name="valid_on" value="{{ __filter_valid_on|split('+')|first }}">
		<table>
			<tr>
				<th class="overflow">{{ 'admin_table_credentials_header_ident'|t }}</th>
				<th>{{ 'admin_table_credentials_header_requester'|t }}</th>
				<th class="center-col">{{ 'admin_table_credentials_header_issued'|t }}</th>
				<th class="center-col">{{ 'admin_table_credentials_header_expires'|t }}</th>
				<th class="center-col">{{ 'admin_table_credentials_header_revoked'|t }}</th>
			</tr>
			{% for credential in credentials %}
			<tr>
				<td>{{ credential.credential_id|split('@')|first }}@<a href="{{ credential.realm_href }}">{{ credential.realm.realm_id }} <small class="oojs-icon oojs-icon-funnel"></small></a></td>
				<td><a href="{{ credential.requester_href }}">{{ credential.requester.user_id }}
					<small class="oojs-icon oojs-icon-funnel"></small></a></td>
				<td class="center-col nowrap-col" title="{{ credential.not_before|date('Y-m-d H:i:s') }}">{{ credential.not_before|date('Y-m-d') }}<span class="hidden-timestamp"> {{ credential.not_before|date('H:i:s') }}</span></td>
				<td class="center-col nowrap-col" title="{{ credential.not_after|date('Y-m-d H:i:s') }}">{{ credential.not_after|date('Y-m-d') }}<span class="hidden-timestamp"> {{ credential.not_after|date('H:i:s') }}</span></td>
				<td class="center-col" title="{{ credential.revoked ? credential.revoked|date('Y-m-d H:i:s') : '' }}">
					{% if credential.revoked %}
					{{ credential.revoked|date('Y-m-d') }}<span class="hidden-timestamp"> {{ credential.revoked|date('H:i:s') }}</span>
					{% else %}
					<button type="button" class="btn-danger" name="revoke_credential" value="{{ credential.credential_id }}" popovertarget="revoke_{{ credential.credential_id }}">{{ 'admin_table_credentials_button_revoke'|t }}</button>
					<dialog class="modal" id="revoke_{{ credential.credential_id }}" popover>
						<h2>{{ 'admin_dialog_revoke_credential_caption' }}</h2>
						<div class="form">
						<dl>
							<dt>{{ 'admin_dialog_revoke_credential_ident' }}</dt>
							<dd>{{ credential.credential_id }}</dd>
						</dl>
						<dl>
							<dt>{{ 'admin_dialog_revoke_credential_requester' }}</dt>
							<dd>{{ credential.requester.user_id }}</dd>
						</dl>
						</div>
						<div class="buttons">
						<button type="submit" class="btn-danger" name="revoke_credential" value="{{ credential.credential_id }}" popovertarget="revoke_{{ credential.credential_id }}">{{ 'admin_dialog_revoke_credential_button_revoke'|t }}</button>
						<button type="button" class="btn-boring" popovertarget="revoke_{{ credential.credential_id }}">{{ 'admin_dialog_revoke_credential_button_cancel'|t }}</button>
						</div>
					</dialog>
					{% endif %}
				</td>
			</tr>
			{% endfor %}
		</table>
	</form>
	{% else %}
	<p>{{ 'No results'|t }}
	{% endif %}
{% endblock %}
